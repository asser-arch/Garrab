{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "garrab-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/admin-api/*"], "not_found_handling": "single-page-application" },
  "services": [{ "binding": "API", "service": "garrab-api" }],
  "vars": { "ENVIRONMENT": "dev", "ADMIN_DEV_TOKEN": "dev-admin-token-local-only" },
  "env": {
    "staging": { "name": "garrab-admin-staging", "vars": { "ENVIRONMENT": "staging" }, "services": [{ "binding": "API", "service": "garrab-api-staging" }] },
    "prod": { "name": "garrab-admin", "vars": { "ENVIRONMENT": "prod" }, "services": [{ "binding": "API", "service": "garrab-api" }] }
  }
}
