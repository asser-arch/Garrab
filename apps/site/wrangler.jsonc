{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "garrab-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "garrab-api"
    }
  ],
  "vars": {
    "API_ORIGIN": "http://localhost:8787",
    "TURNSTILE_SITE_KEY": "mock",
    "ENVIRONMENT": "dev",
    "API_DEV_URL": "http://127.0.0.1:8787",
    "APP_HOST": "localhost"
  },
  "env": {
    "staging": {
      "name": "garrab-site-staging",
      "services": [
        {
          "binding": "API",
          "service": "garrab-api-staging"
        }
      ],
      "vars": {
        "API_ORIGIN": "https://api-staging.garrabb.com",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "ENVIRONMENT": "staging",
        "APP_HOST": "app-staging.garrabb.com"
      },
      "routes": [
        {
          "pattern": "app-staging.garrabb.com",
          "custom_domain": true
        }
      ]
    },
    "prod": {
      "name": "garrab-site",
      "services": [
        {
          "binding": "API",
          "service": "garrab-api"
        }
      ],
      "vars": {
        "API_ORIGIN": "https://api.garrabb.com",
        "TURNSTILE_SITE_KEY": "REPLACE_AT_PART_7",
        "ENVIRONMENT": "prod",
        "APP_HOST": "app.garrabb.com"
      },
      "routes": [
        {
          "pattern": "app.garrabb.com",
          "custom_domain": true
        },
        {
          "pattern": "cdn.garrabb.com",
          "custom_domain": true
        },
        {
          "pattern": "garrabb.com",
          "custom_domain": true
        },
        {
          "pattern": "www.garrabb.com",
          "custom_domain": true
        }
      ]
    }
  }
}
