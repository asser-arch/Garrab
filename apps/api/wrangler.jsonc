{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "garrab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "dev",
    "APP_ORIGIN": "http://localhost:8788",
    "GENLOOK_MOCK": "true",
    "GENLOOK_USD_PER_CREDIT": "0.04",
    "MOCK_TURNSTILE": "pass",
    "ADMIN_DEV_TOKEN": "dev-admin-token-local-only",
    "INSTAPAY_IPA": "asserrostom@instapay",
    "INSTAPAY_ACCOUNT_NAME": "Asser Rostom",
    "TELEGRAM_WEBHOOK_SECRET": "dev-telegram-secret-local-only",
    "TELEGRAM_CHAT_ID": "424242",
    "OPERATOR_EMAIL": "ops@garrab.local",
    "ADMIN_ORIGIN": "http://localhost:8789"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "garrab-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "RL_TRYON_IP", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_TRYON_KEY", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_CONFIG_IP", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "garrab-files-dev" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "garrab-jobs-dev" }],
    "consumers": [{ "queue": "garrab-jobs-dev", "max_batch_size": 5, "max_retries": 5, "max_batch_timeout": 5 }]
  },
  "env": {
    "staging": {
      "name": "garrab-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "INSTAPAY_IPA": "asserrostom@instapay",
        "INSTAPAY_ACCOUNT_NAME": "Asser Rostom",
        "ADMIN_ORIGIN": "https://admin.staging.REPLACE_DOMAIN",
        "APP_ORIGIN": "https://app.staging.REPLACE_DOMAIN",
        "GENLOOK_MOCK": "false",
        "GENLOOK_USD_PER_CREDIT": "0.04"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "garrab-staging", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "REPLACE_ME" }],
      "ratelimits": [
        { "name": "RL_TRYON_IP", "namespace_id": "2001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_TRYON_KEY", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_CONFIG_IP", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "garrab-files-staging" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "garrab-jobs-staging" }],
        "consumers": [{ "queue": "garrab-jobs-staging", "max_batch_size": 5, "max_retries": 5, "max_batch_timeout": 5 }]
      }
    },
    "prod": {
      "name": "garrab-api",
      "vars": {
        "ENVIRONMENT": "prod",
        "INSTAPAY_IPA": "asserrostom@instapay",
        "INSTAPAY_ACCOUNT_NAME": "Asser Rostom",
        "ADMIN_ORIGIN": "https://admin.REPLACE_DOMAIN",
        "APP_ORIGIN": "https://app.REPLACE_DOMAIN",
        "GENLOOK_MOCK": "false",
        "GENLOOK_USD_PER_CREDIT": "0.04"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "garrab-prod", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "REPLACE_ME" }],
      "ratelimits": [
        { "name": "RL_TRYON_IP", "namespace_id": "3001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_TRYON_KEY", "namespace_id": "3002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_CONFIG_IP", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "garrab-files-prod" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "garrab-jobs-prod" }],
        "consumers": [{ "queue": "garrab-jobs-prod", "max_batch_size": 5, "max_retries": 5, "max_batch_timeout": 5 }]
      }
    }
  }
}
