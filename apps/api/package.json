{
  "name": "@garrab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-dev.sql",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "verify:genlook-delete": "node --experimental-strip-types scripts/verify-genlook-delete.ts"
  },
  "dependencies": {
    "@garrab/shared": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261030.1",
    "wrangler": "4.156.0"
  }
}
