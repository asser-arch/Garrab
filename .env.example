# Garrab environment variables.
# Local dev: copy the values you need into apps/api/.dev.vars (never commit it).
# Staging and prod: set each secret with `wrangler secret put NAME --env <staging|prod>`.
# Every provider has a mock; leave a key empty in dev and the mock is used.

# --- Environment ---
ENVIRONMENT=dev                 # dev | staging | prod
PUBLIC_DOMAIN=garrab.example    # your apex domain (api., app., cdn., admin. are derived)

# --- Signing keys (generate: openssl rand -base64 48) ---
CTX_SIGNING_KEY=
SESSION_SIGNING_KEY=
PAY_TOKEN_KEY=

# --- Cloudflare ---
TURNSTILE_SITE_KEY=             # public, hostname app.<domain>
TURNSTILE_SECRET=
CF_ACCESS_TEAM_DOMAIN=          # e.g. garrab.cloudflareaccess.com (admin login)
CF_ACCESS_AUD=                  # Access application audience tag

# --- AI providers (paid tiers only) ---
GENLOOK_API_KEY=                # starts with gk_
GENLOOK_MOCK=true               # true = free mock calls (Genlook `mock: true`)
GEMINI_API_KEY=
GEMINI_ROOM_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# --- Payments ---
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=         # comma-separated, e.g. 123456,123457 (card, wallet)
KASHIER_MID=
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
KASHIER_MODE=test               # test | live

# --- Email and alerts ---
RESEND_API_KEY=
EMAIL_FROM="Garrab <hello@garrab.example>"
OPERATOR_EMAIL=                 # where the daily digest goes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CI deploy only (GitHub Actions secrets, not Worker secrets) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
