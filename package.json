{
  "name": "garrab",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @garrab/widget --filter @garrab/frame build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@garrab/e2e test",
    "e2e": "pnpm --filter @garrab/e2e e2e",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
