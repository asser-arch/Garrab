{
  "name": "garrab",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @garrab/site --filter @garrab/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@garrab/e2e test",
    "e2e": "pnpm --filter @garrab/e2e e2e",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.1",
    "globals": "17.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
